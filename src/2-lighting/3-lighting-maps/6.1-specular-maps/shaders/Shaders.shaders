#shader vertex
#version 330 core

// --- Inputs from the vertex buffer ---
layout (location = 0) in vec3 a_Position;
layout (location = 1) in vec3 a_Color;
layout (location = 2) in vec2 a_TexCoord;
layout (location = 3) in vec3 a_Normal;

// --- Outputs to the fragment shader ---
out vec3 v_Color;
out vec2 v_TexCoord;
out vec3 v_Normal;
out vec3 v_CrntPosition;

// --- Uniforms ---
uniform float u_Scale;
uniform mat4 u_MVP; // Model View Proyection matrix
uniform mat4 u_Model; // We need Model also...

void main()
{
  // Transform position to world space for lighting calculations
  v_CrntPosition = vec3(u_Model * vec4(a_Position * u_Scale, 1.0f));
  
  // Transform normals to world space (correct for non-uniform scaling/rotation)
  v_Normal = mat3(transpose(inverse(u_Model))) * a_Normal;
  
  // Transform position to clip space for rendering
  gl_Position = u_MVP * vec4(a_Position * u_Scale, 1.0);
  
  // Pass through color and texture coordinates
  v_Color = a_Color;
  v_TexCoord = a_TexCoord;
};


// =======================================================================


#shader fragment
#version 330 core

layout(location = 0) out vec4 o_FragColor;

// --- Inputs from vertex shader ---
in vec2 v_TexCoord;
in vec3 v_Color;
in vec3 v_Normal;
in vec3 v_CrntPosition;

// --- Uniforms ---
uniform sampler2D u_Texture;
uniform sampler2D u_SpecularMap;    // Specular map texture
uniform vec4 u_LightColor; 
uniform vec3 u_LightTranslation;
uniform float u_AmbientLight;
uniform vec3 u_CameraPosition;

void main()
{
  // Normalize vectors for lighting calculations
  vec3 f_Normal = normalize(v_Normal);
  vec3 f_LightDirection = normalize(u_LightTranslation - v_CrntPosition);

  // ========== DIFFUSE LIGHTING ==========
  // How much surface faces the light (0.0 to 1.0)
  float f_Diffuse = max(dot(f_Normal, f_LightDirection), 0.0);

  // ========== SPECULAR LIGHTING ==========
  float f_Specular = 0.0;
  
  // Only calculate specular if surface faces the light (optimization)
  if (f_Diffuse > 0.0)
  {
    vec3 f_ViewDirection = normalize(u_CameraPosition - v_CrntPosition);
    vec3 f_ReflectionDirection = reflect(-f_LightDirection, f_Normal);
    
    // Calculate base specular amount (shininess = 256)
    float f_SpecAmount = pow(max(dot(f_ViewDirection, f_ReflectionDirection), 0.0), 256.0);
    
    // Sample specular map to determine which areas should be shiny
    // Bright areas in specular map = shiny, dark areas = not shiny
    vec3 f_SpecularMapValue = texture(u_SpecularMap, v_TexCoord).rgb;
    
    // Use red channel of specular map to modulate specular intensity
    f_Specular = f_SpecAmount * f_SpecularMapValue.r;
  }

  // ========== COMBINE ALL LIGHTING ==========
  // Ambient: base illumination
  vec3 ambient = u_AmbientLight * texture(u_Texture, v_TexCoord).rgb;
  
  // Diffuse: main surface color affected by light direction
  vec3 diffuse = f_Diffuse * texture(u_Texture, v_TexCoord).rgb;
  
  // Specular: shiny highlights (white light reflection)
  vec3 specular = f_Specular * vec3(1.0); // White specular highlight
  
  // Combine all components and apply light color
  vec3 finalColor = (ambient + diffuse + specular) * u_LightColor.rgb;
  
  o_FragColor = vec4(finalColor, 1.0);
}